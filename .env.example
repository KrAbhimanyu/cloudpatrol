# CloudPatrol configuration template.
#
# Copy to .env and fill in real values. This file documents variable NAMES
# only and must never contain secrets.
#
# CloudPatrol reads AWS credentials ONLY from a cross-account role that the
# customer creates and grants. There is deliberately no place to put a static
# AWS access key here: long-lived keys held by the platform would be a far
# larger risk than the temporary, scoped credentials the AssumeRole flow
# produces. This is why no AWS_ACCESS_KEY_ID exists below.

# --- Application ------------------------------------------------------------
# One of: local, test, staging, production.
# Outside local/test the API refuses to start if Supabase settings are missing.
APP_ENV=local
APP_NAME=CloudPatrol API
# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL.
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# --- Supabase ---------------------------------------------------------------
# Project URL. Replace with your own, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable (anon) key. Safe to expose to the browser. Replace with your own.
SUPABASE_ANON_KEY=replace-me-with-your-publishable-key
# Service role key. SERVER-SIDE ONLY. It bypasses Row Level Security, so it
# must never reach a browser bundle or a client-visible response.
# Replace with your own; never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=replace-me-with-your-service-role-key
# Shared secret used to verify HS256 access tokens. Leave EMPTY when the
# project uses asymmetric signing keys (the default) — JWKS verification is
# used instead and no shared secret exists. If set, it must be a high-entropy
# secret of at least 32 characters; a URL or public key is rejected at startup
# because it would let anyone forge a token.
SUPABASE_JWT_SECRET=
# Signing algorithms accepted for access tokens. This is an allow-list read
# from configuration, never from the token header. Do not mix symmetric (HS*)
# and asymmetric (RS*/ES*) algorithms; that combination enables algorithm
# confusion. Use "HS256" with SUPABASE_JWT_SECRET for the legacy shared-secret
# setup, or leave the default for asymmetric Supabase signing keys.
SUPABASE_JWT_ALGORITHMS=RS256,ES256
# Optional PostgreSQL connection string for the API. Leave EMPTY for now: the
# API runs entirely on the in-memory store and does not connect to a database.
# It is reserved for a later phase and is not required for startup. When set,
# it is server-side only and must never be exposed to the browser.
DATABASE_URL=

# --- PostgreSQL integration tests (opt-in, tests only) ---------------------
# Not read by the API. The integration suite uses it to create a disposable
# database (cloudpatrol_it_<random>), applies the migrations to it, runs the
# repository tests, then drops it. Leave it unset and those tests skip.
#
# Point it at a THROWAWAY server only. It must never be a Supabase project or
# any database holding real data: the harness creates and drops databases. A
# Supabase host is refused outright, as is a non-loopback host unless
# CLOUDPATROL_ALLOW_NONLOCAL_TEST_DB=1 is set deliberately.
#
# Example (local server, no password committed here):
#   TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
TEST_DATABASE_URL=

# --- AWS integration --------------------------------------------------------
# Region used when a call needs one and the account specifies none.
AWS_DEFAULT_REGION=us-east-1
# Comma-separated allow-list of regions a scan may target. A customer-supplied
# region outside this list is rejected before any AWS call is made.
AWS_ALLOWED_REGIONS=us-east-1,us-west-2,eu-west-1,ap-south-1,ap-southeast-1
# Bounds on every AWS call, so a hung endpoint cannot hold a request open.
AWS_CONNECT_TIMEOUT_SECONDS=5
AWS_READ_TIMEOUT_SECONDS=30
# Total attempts per call, including the first. Applies to throttling only.
AWS_MAX_RETRY_ATTEMPTS=4

# --- CORS -------------------------------------------------------------------
# Comma-separated list of allowed browser origins. Never "*" in production:
# combined with bearer tokens it would let any site drive the API.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Frontend (apps/web) ----------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Same project URL as SUPABASE_URL above. Replace with your own.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Same publishable key as SUPABASE_ANON_KEY above. Replace with your own.
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-me-with-your-publishable-key
# Extra origins allowed to send state-changing requests (POST/PUT/PATCH/DELETE)
# to the web app's BFF proxy and to invoke Server Actions. Comma-separated,
# full origins for the proxy and bare hosts are also accepted here. The app's
# own origin is always trusted, so this is only needed when the app is reached
# by more than one hostname, or when it sits behind a reverse proxy that
# forwards its own host instead of the public one. Leave empty otherwise.
APP_ORIGINS=
